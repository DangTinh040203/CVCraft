# Build: docker build -f docker/Dockerfile.client --build-arg NEXT_PUBLIC_...=... .

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

FROM base AS pruner
WORKDIR /app
COPY . .
RUN pnpm dlx turbo@2.10.4 prune @repo/client --docker

FROM base AS builder
WORKDIR /app
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ ./
# NEXT_PUBLIC_* are inlined into the bundle at build time. Keep this list in
# sync with apps/client/configs/env.config.ts and the grep in deploy.yml.
# NEXT_PUBLIC_WS_URL is left out on purpose: unset, the interview socket uses
# the API origin, while an empty build arg would inline "".
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CLERK_SIGN_IN_URL
ARG NEXT_PUBLIC_REDIRECT_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
  NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
  NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY \
  NEXT_PUBLIC_CLERK_SIGN_IN_URL=$NEXT_PUBLIC_CLERK_SIGN_IN_URL \
  NEXT_PUBLIC_REDIRECT_URL=$NEXT_PUBLIC_REDIRECT_URL \
  # CLERK_SECRET_KEY only exists at runtime; it is validated when the server boots
  SKIP_ENV_VALIDATION=true \
  NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @repo/client build

FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production \
  NEXT_TELEMETRY_DISABLED=1 \
  PORT=3001 \
  HOSTNAME=0.0.0.0
WORKDIR /app
# The standalone output mirrors the monorepo: the server is apps/client/server.js
COPY --from=builder --chown=node:node /app/apps/client/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/client/.next/static ./apps/client/.next/static
COPY --from=builder --chown=node:node /app/apps/client/public ./apps/client/public
USER node
EXPOSE 3001
CMD ["node", "apps/client/server.js"]
