# Build: docker build -f docker/Dockerfile.backend .   (context = repo root)

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# Puppeteer drives the apt Chromium installed in the runner
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN corepack enable

# Keep only the backend and the workspace packages it depends on
FROM base AS pruner
WORKDIR /app
COPY . .
RUN pnpm dlx turbo@2.10.4 prune @repo/backend --docker

FROM base AS builder
WORKDIR /app
# Dependencies first, so source changes don't invalidate this layer
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ ./
# The generated Prisma client is gitignored; `nest build` compiles it into dist
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build \
  pnpm --filter @repo/backend db:generate
RUN pnpm --filter @repo/backend build
# A self-contained copy of the backend with production dependencies only
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm --filter @repo/backend deploy --prod --legacy /prod/backend

FROM node:22-bookworm-slim AS runner
# Chromium pulls in the shared libraries it needs; the fonts cover Latin,
# Vietnamese and emoji in templates that fall back past their web font
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    chromium fonts-liberation fonts-dejavu-core fonts-noto-color-emoji \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WORKDIR /app
COPY --from=builder --chown=node:node /prod/backend ./
COPY --from=builder --chown=node:node /app/apps/backend/dist ./dist
USER node
EXPOSE 8000
CMD ["node", "dist/main"]
