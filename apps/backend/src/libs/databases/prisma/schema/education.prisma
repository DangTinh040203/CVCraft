model Education {
  id     String @id @default(uuid())
  school String
  degree String
  major  String

  startDate DateTime
  endDate   DateTime? // Null = "Present"
  order     Int       @default(0)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}
