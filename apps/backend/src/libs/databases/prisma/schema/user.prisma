enum UserRole {
  USER
  ADMIN
}

model User {
  id         String   @id @default(uuid())
  providerId String
  provider   String
  firstName  String?
  lastName   String?
  email      String   @unique
  avatar     String?
  role       UserRole @default(USER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("users")
}
