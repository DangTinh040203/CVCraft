PORT=8000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3001
# Where headless Chromium opens the /print page for PDF export (defaults to FRONTEND_ORIGIN)
# PDF_RENDER_URL=http://localhost:3001

API_PREFIX=api
API_VERSION=1

CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/craftcv_db?schema=public"

REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=craftcv

THROTTLE_TTL=60000
THROTTLE_LIMIT=10

GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-3.5-flash-lite
# Used when GEMINI_MODEL stays overloaded (empty disables)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live

RESEND_API_KEY=re_xxx
MAIL_FROM_ADDRESS=apply@your-domain.com
MAIL_DAILY_LIMIT_PER_USER=5
