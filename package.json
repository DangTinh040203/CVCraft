{
  "name": "craftcv",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:client": "turbo run build --filter=@repo/client",
    "build:backend": "turbo run build --filter=@repo/backend",
    "build:admin": "turbo run build --filter=@repo/admin",
    "dev": "turbo run dev --parallel --filter=@repo/client --filter=@repo/backend --filter=@repo/admin",
    "dev:client": "turbo run dev --filter=@repo/client",
    "dev:backend": "turbo run dev --filter=@repo/backend",
    "dev:admin": "turbo run dev --filter=@repo/admin",
    "dev:setup": "docker compose -f docker/docker-compose.dev.yml --profile tunnel pull && docker compose -f docker/docker-compose.dev.yml up -d",
    "dev:tunnel": "docker compose -f docker/docker-compose.dev.yml --profile tunnel up -d ngrok && docker compose -f docker/docker-compose.dev.yml logs -f ngrok",
    "dev:tunnel:down": "docker compose -f docker/docker-compose.dev.yml --profile tunnel stop ngrok",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\""
  },
  "devDependencies": {
    "@repo/prettier-config": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "prettier": "@repo/prettier-config",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@nestjs/core",
      "msgpackr-extract"
    ]
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0"
}
